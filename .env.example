# Copy to .env.local and fill in. All optional — with none set, the summary form
# falls back to a mailto: handoff exactly as the prototype does.

# Where specification submissions are emailed.
FACTORY_EMAIL=sales@denimassembly.com

# Resend (https://resend.com) — used by /api/quote to email the factory.
# Leave blank to disable automated email; the endpoint still stores the submission.
RESEND_API_KEY=
RESEND_FROM="Denim Assembly <quotes@denimassembly.com>"

# Public site origin, used for absolute links in emails / OG tags.
NEXT_PUBLIC_SITE_URL=https://denimassembly.com
